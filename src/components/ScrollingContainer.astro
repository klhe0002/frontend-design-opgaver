---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    scroll-snap-type: x mandatory;
    list-style: none;
    display: flex;
    gap: var(--card-gap);
    overflow-x: auto;

    li {
      flex-basis: min(400px, 90%);
      flex-shrink: 0;
      background: var(--card-background);
      color: var(--card-text-color);
      border-radius: var(--card-border-radius);
      font-size: 1rem;
      padding: var(--card-padding);
      align-self: start;

      h3 {
        font-weight: 700;
        font-size: 1.5625rem;
      }
    }
  }

  .full-width {
    grid-column: 1 / -1;
    padding-inline: max(1rem, 50% - var(--content-width) / 2);

    > ul {
      scroll-snap-type: x mandatory;
      grid-column: full;
      padding-inline: max(1rem, 50% - var(--content-width) / 2);
      padding-block-end: 1rem;
    }

    > li {
   
        scroll-snap-align: center;
    
  }
</style>
